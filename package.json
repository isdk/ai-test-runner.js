{
  "name": "@isdk/ai-test-runner",
  "version": "0.3.0",
  "author": "Riceball LEE <snowyu.lee@gmail.com>",
  "description": "A general-purpose core engine for testing AI scripts, agents, and prompts with multiple validation strategies.",
  "keywords": [
    "ai",
    "test",
    "testing",
    "runner",
    "agent",
    "prompt",
    "validation",
    "json-schema",
    "diff",
    "isdk"
  ],
  "homepage": "https://github.com/isdk/ai-test-runner.js",
  "repository": "https://github.com/isdk/ai-test-runner.js",
  "bugs": "https://github.com/isdk/ai-test-runner.js/issues",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build-fast": "tsup",
    "build": "pnpm run build-fast --dts-resolve --dts && pnpm run doc:md",
    "clean": "rm -fr web docs dist",
    "doc": "typedoc --plugin none --out web",
    "doc:md": "typedoc --plugin typedoc-plugin-markdown --out docs",
    "format": "pnpm run format:base -c",
    "format:base": "prettier \"src/**/*.{ts,tsx,js,jsx,css,scss,sass,less,md}\"",
    "format:fix": "pnpm run format:base --write",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "style": "pnpm run format:base -c && pnpm run lint",
    "style:fix": "pnpm run format:fix && npm run lint:fix",
    "test": "vitest run",
    "release": "pnpm run clean && pnpm run build && git add -f docs && git ci -m 'docs: update API docs' && pnpm dlx commit-and-tag-version -s",
    "release.alpha": "pnpm run release -- --prerelease alpha"
  },
  "dependencies": {
    "@isdk/ai-tool": "workspace:^",
    "@isdk/ai-tool-agent": "workspace:^",
    "@isdk/match-ex": "workspace:^",
    "@isdk/match-ex-schema": "workspace:^",
    "@isdk/match-ex-template": "workspace:^",
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-tsdoc": "^0.5.3",
    "prettier": "^3.9.7",
    "terser": "^5.51.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "~5.7.3",
    "vite": "^8.3.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.1"
  }
}
